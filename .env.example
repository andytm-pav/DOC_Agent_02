# --- Секреты (скопируйте в .env и заполните) ---
# Скопируйте этот файл в .env:  copy .env.example .env   (Windows)

# Ключ подписи JWT (ОБЯЗАТЕЛЬНО заменить на случайную строку)
SECRET_KEY=change-me-to-random-string

# Ключ внешней LLM по API (OpenAI-совместимый провайдер)
# Используется, если в config/config.yaml: llm.provider: openai_compatible
LLM_API_KEY=

# Ключ эмбеддинг-API (ОТДЕЛЬНЫЙ от LLM). Нужен ТОЛЬКО если эмбеддинг-модель
# живёт у другого провайдера, чем LLM. Типичный случай (v2.8): LLM —
# api.z.ai, эмбеддинги embedding-3 — open.bigmodel.cn (у международного
# Z.ai эмбеддингов НЕТ, а ключи z.ai и bigmodel.cn НЕ совпадают).
# Подключается в config/config.yaml:
#   embeddings:
#     api:
#       base_url: "https://open.bigmodel.cn/api/paas/v4"
#       api_key: "${EMBEDDING_API_KEY}"
#       dimensions: 1024
# Если embeddings.api.base_url и api_key пусты — эмбеддинги наследуют
# LLM_API_KEY (один провайдер и для LLM, и для эмбеддингов).
EMBEDDING_API_KEY=

# Ключ доступа к API агента ИЗ внешних систем (заголовок X-API-Key)
# Работает, если в config/config.yaml секция auth.api_keys ссылается на ${EXTERNAL_API_KEY}
# Сюда подключаются ваши внешние программы/агенты: curl, n8n, 1С, скрипты и т.д.
EXTERNAL_API_KEY=

# Администратор по умолчанию (создаётся при первом старте)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# URL локального Ollama (если llm.provider: ollama)
OLLAMA_URL=http://localhost:11434
